/><column index="7" value="65"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 3*">INSERT INTO Pescaria
(nome_pescador, isca_utilizada, data, local,
 observacao, id_peixe)
VALUES
(
    'Carlos',
    'Tuvira',
    '2026-10-15',
    'Rio Paraná',
    'Dourado capturado próximo às corredeiras.',
    (SELECT id_peixe FROM Peixe
     WHERE nome_peixe = 'Dourado')
),
(
    'Marcos',
    'Isca artificial de superfície',
    '2026-10-20',
    'Represa de Serra da Mesa',
    'Tucunaré capturado durante a manhã.',
    (SELECT id_peixe FROM Peixe
     WHERE nome_peixe = 'Tucunaré')
),
(
    'Ana',
    'Milho',
    '2026-11-02',
    'Rio Paraná',
    'Pacu capturado próximo à vegetação.',
    (SELECT id_peixe FROM Peixe
     WHERE nome_peixe = 'Pacu')
),
(
    'Pedro',
    'Tuvira',
    '2026-11-10',
    'Rio Paraná',
    'Segundo relato de pescaria de Dourado.',
    (SELECT id_peixe FROM Peixe
     WHERE nome_peixe = 'Dourado')
);</sql><sql name="SQL 4*">SELECT
    Pescaria.id_pescaria,
    Peixe.nome_peixe,
    Pescaria.nome_pescador,
    Pescaria.data,
    Pescaria.local,
    Pescaria.isca_utilizada
FROM Pescaria
JOIN Peixe
    ON Pescaria.id_peixe = Peixe.id_peixe
ORDER BY Pescaria.id_pescaria;</sql><current_tab id="1"/></tab_sql></sqlb_project>
